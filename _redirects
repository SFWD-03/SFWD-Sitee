# Netlify SPA redirects — serve index.html for all paths not matching a real file
# This fixes "Destination not working" disapprovals for Google Ads landing page URLs

# Specific paths used in Google Ads (catches location-insertion macros like /windows/miami)
/windows          /index.html  200
/windows/*        /index.html  200
/impact-windows   /index.html  200
/impact-windows/* /index.html  200

# Static ad landing page paths
/custom/windows   /index.html  200
/aluminum/windows /index.html  200

# Other site sections referenced in canonical URLs
/doors            /index.html  200
/doors/*          /index.html  200
/commercial       /index.html  200
/commercial/*     /index.html  200
/contact          /index.html  200
/service-areas    /index.html  200
/service-areas/*  /index.html  200
/financing        /index.html  200
/reviews          /index.html  200
/about            /index.html  200
/our-work         /index.html  200
/wholesale        /index.html  200
/referral         /index.html  200
/blog             /index.html  200
